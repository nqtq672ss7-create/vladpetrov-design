export default async function handler(req, res) {
    // Разрешаем только POST-запросы
    if (req.method !== 'POST') {
        return res.status(405).json({ error: 'Метод не поддерживается' });
    }

    // Берем API ключ из скрытых переменных окружения сервера
    const apiKey = process.env.GEMINI_API_KEY;
    
    if (!apiKey) {
        console.error("CRITICAL: GEMINI_API_KEY is not set in environment variables.");
        return res.status(500).json({ error: 'Ошибка конфигурации сервера. API ключ не найден.' });
    }

    const { userPrompt, systemPrompt } = req.body;

    if (!userPrompt) {
        return res.status(400).json({ error: 'Пустой запрос' });
    }

    // Формируем payload для Gemini
    const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
    const payload = {
        contents: [{ parts: [{ text: userPrompt }] }],
        systemInstruction: systemPrompt ? { parts: [{ text: systemPrompt }] } : undefined
    };

    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (!response.ok) {
            console.error("Gemini API Error:", data);
            return res.status(response.status).json({ error: 'Ошибка при генерации ответа от нейросети.' });
        }

        // Извлекаем текст из ответа Google
        const text = data.candidates?.[0]?.content?.parts?.[0]?.text;

        if (!text) {
            return res.status(500).json({ error: 'Получен пустой ответ от нейросети.' });
        }

        // Возвращаем результат на наш фронтенд
        res.status(200).json({ text });
    } catch (error) {
        console.error("Serverless Function Error:", error);
        res.status(500).json({ error: 'Внутренняя ошибка сервера при обращении к AI.' });
    }
}
